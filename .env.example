# Copy this file to .env before running scripts/setup-local.sh.

# Official OpenClaw images are published to GitHub Container Registry.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Host-side persisted state. Relative paths are resolved from this repo root.
OPENCLAW_CONFIG_DIR=./data/config
OPENCLAW_WORKSPACE_DIR=./data/workspace

# Env file passed into the container. Keep this as .env for local single-user
# setup. Shared-host scripts set it to each participant's env file.
OPENCLAW_CONTAINER_ENV_FILE=.env

# Local-only host publish by default. For a VM, keep this as 127.0.0.1 and
# access it with SSH tunneling or Bastion instead of a public port.
OPENCLAW_PUBLISH_HOST=127.0.0.1
OPENCLAW_PUBLIC_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan

# Generated by scripts/setup-local.sh if left empty.
OPENCLAW_GATEWAY_TOKEN=

# Disable local-network mDNS advertising for lab safety.
OPENCLAW_DISABLE_BONJOUR=1

# Set to your local timezone if useful, for example Europe/Stockholm.
OPENCLAW_TZ=Europe/Stockholm

# Optional provider keys. Prefer entering keys during onboarding when possible.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
