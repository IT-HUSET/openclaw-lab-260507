# Copy to resources/azure.env and edit before running scripts/azure/provision-vm.sh.

RG=rg-openclaw-lab
LOCATION=westeurope

VNET_NAME=vnet-openclaw-lab
VNET_PREFIX=10.40.0.0/16
VM_SUBNET_NAME=snet-openclaw-vm
VM_SUBNET_PREFIX=10.40.2.0/24
BASTION_SUBNET_PREFIX=10.40.1.0/26

NSG_NAME=nsg-openclaw-vm
VM_NAME=vm-openclaw-lab
ADMIN_USERNAME=openclaw

BASTION_NAME=bas-openclaw-lab
BASTION_PIP_NAME=pip-openclaw-bastion

SSH_PUBLIC_KEY_PATH=$HOME/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=$HOME/.ssh/id_ed25519

VM_SIZE=Standard_B2as_v2
OS_DISK_SIZE_GB=64
