# Copy to resources/lab-secrets.env on the facilitator/shared host.
# Never commit the real lab-secrets.env file.

# When this file exists, shared-host setup scripts can preconfigure participant
# instances non-interactively from these values.
OPENCLAW_LAB_PRECONFIGURE=1

# Lab posture requested for this kit: broad tool access, no OpenClaw tool
# sandbox, host exec without approval prompts, and filesystem tools not limited
# to the workspace. Use only with trusted participants and dedicated lab hosts.
OPENCLAW_LAB_UNRESTRICTED=1

# Enable TLS termination at the gateway with an auto-generated self-signed cert.
# Required when participants reach the gateway over a non-loopback hostname/IP
# (any LAN address) because the Control UI demands a browser secure context for
# device identity. With this on, gateway URLs are https://; participants will
# see a one-time browser warning for the self-signed cert. Also forces a
# literal gateway token (instead of a SecretRef) so login is enforced reliably.
OPENCLAW_LAB_TLS=1

# Optional default model applied to every preconfigured instance via
# `agents.defaults.model`. Format is `provider/model`. Per-participant overrides
# use the uppercase id prefix (e.g. P01_OPENCLAW_LAB_DEFAULT_MODEL=...).
# Examples:
#   anthropic/claude-sonnet-4-6
#   anthropic/claude-opus-4-7
#   openai/gpt-5.5
# OPENCLAW_LAB_DEFAULT_MODEL=

# Optional. If unset, scripts infer this from the first configured provider key.
# Common values:
#   apiKey                 # Anthropic
#   openai-api-key
#   openrouter-api-key
#   gemini-api-key
#   mistral-api-key
#   moonshot-api-key
#   zai-api-key
#   ai-gateway-api-key
#   custom-api-key
#   skip                  # no model provider key
OPENCLAW_LAB_AUTH_CHOICE=

# Shared provider keys. Prefer one key per participant when possible.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# AI_GATEWAY_API_KEY=

# Per-participant overrides use the uppercase participant id as a prefix.
# P01_ANTHROPIC_API_KEY=
# P02_ANTHROPIC_API_KEY=

# Custom provider, if OPENCLAW_LAB_AUTH_CHOICE=custom-api-key.
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL_ID=
# CUSTOM_PROVIDER_ID=lab-custom
# CUSTOM_COMPATIBILITY=openai
